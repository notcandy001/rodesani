{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoryBloom Studio",
  "version": "0.1.0",
  "identifier": "com.notcandy001.storybloom-studio",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "StoryBloom Studio",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../config/*.toml": "config/"
    }
  }
}
